{
  "name": "express-app",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "debug": "node --inspect --watch --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env src/database/check.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "dotenv -- node-pg-migrate",
    "migrate:create": "dotenv -- node-pg-migrate create",
    "migrate:down": "dotenv -- node-pg-migrate down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0"
  }
}
